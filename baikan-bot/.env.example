# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Чат, куда приходят заявки на запись (id администратора или группы; узнать — @userinfobot)
ADMIN_CHAT_ID=0
# Ключ Anthropic для ответов на свободные вопросы. Без ключа бот работает только по кнопкам.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Файл с информацией о салоне и база заявок
SALON_FILE=salon.json
DB_PATH=bookings.db
